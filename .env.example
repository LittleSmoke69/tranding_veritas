# Banco compartilhado com o CRM
NEXT_PUBLIC_SUPABASE_URL=https://seu-supabase.example
SUPABASE_SERVICE_ROLE_KEY=defina-no-secret-manager

# Sessões e worker
SESSION_SECRET=gere-um-segredo-longo
VERITAS_WORKER_SECRET=gere-outro-segredo-longo

# Serviços
VERITAS_API_PORT=4010
VERITAS_API_URL=http://127.0.0.1:4010
VERITAS_WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Deploy via docker-compose.yml (produção) — VERITAS_WEB_ORIGIN e VERITAS_API_URL
# já são sobrescritos ali para os nomes dos containers (api/web); só é preciso
# preencher aqui o token do túnel Cloudflare dedicado a este domínio.
CLOUDFLARE_TUNNEL_TOKEN=cole-o-token-do-tunnel-aqui
